{
  "manifest_version": 3,
  "name": "Job Applications Tracker",
  "version": "0.1.0",
  "description": "One-click capture of job postings into your local tracker.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Track this job",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/viewjob*",
        "*://*.indeed.com/jobs/*",
        "*://*.glassdoor.com/job-listing/*",
        "*://*.glassdoor.com/Job/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.dayforcehcm.com/*/jobs/*",
        "*://*.greenhouse.io/jobs/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*/jobs/*",
        "*://*.icims.com/*",
        "*://*.jobvite.com/*",
        "*://*.ultipro.com/*",
        "*://*.brassring.com/*",
        "*://*.taleo.net/*",
        "*://*.successfactors.com/*",
        "*://*.applytojob.com/*",
        "*://*.bamboohr.com/careers/*",
        "*://*.rippling.com/careers/*"
      ],
      "js": ["content-ui.js"],
      "run_at": "document_idle"
    }
  ]
}
