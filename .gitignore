.DS_Store
*.log
.vscode/
.idea/
.claude/

# SQLite binary (bind-mounted) — backed up as SQL dump instead
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Timestamped binary DB backups (e.g. jobs.db.backup-20260515-124211)
data/*.backup-*

# Keep the backup SQL dump tracked
!data/backup.sql
